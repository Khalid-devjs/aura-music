# ============ AURA MUSIC BOT — ENVIRONMENT ============
# Copy this file to .env and fill in your values.

# --- Telegram API credentials (from https://my.telegram.org) ---
API_ID=1234567
API_HASH=your_api_hash_here

# --- Bot token (from @BotFather) ---
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- USER account Pyrogram string session (voice chats need a user account) ---
# Generate with: python -c "from pyrogram import Client; ..." or use
# `pyrogram session` helpers — see README section "Getting a string session".
SESSION_STRING=1BVtsOKM-....paste_your_string_session_here

# --- Owner Telegram user ID (full control) ---
OWNER_ID=8333953794

# --- Database (SQLite by default) ---
# DB_PATH=musicbot.db
# DATABASE_URL=sqlite:///musicbot.db

# --- Player ---
# CACHE_DIR=cache
# MAX_QUEUE=50
# MAX_DURATION=0
# DEFAULT_VOLUME=100
# MAX_TRACK_SIZE_MB=512
# YT_CLIENT=tv              # youtube extractor client: tv (default) / android / ios / default
# COOKIES_FILE=             # path to cookies.txt if YouTube still blocks you

# --- Behaviour ---
# AUTO_DELETE_MS=30000
# LOG_CHANNEL_ID=0
# BOT_USERNAME=
# SUPPORT_CHAT=
# BOT_NAME=Aura Music
